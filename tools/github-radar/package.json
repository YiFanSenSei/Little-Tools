{
  "name": "github-radar",
  "version": "1.0.2",
  "private": true,
  "description": "GitHub Trending 本地发现助手",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "scan": "node --env-file-if-exists=.env server.mjs --scan",
    "test": "node --test test/core.test.mjs test/flow.test.mjs test/http.test.mjs test/release.test.mjs test/network.test.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": { "node": ">=22.21.0" },
  "files": ["server.mjs", "lib/", "web/", "scripts/", "test/", "docs/", "LICENSE", "CONTRIBUTING.md", "SECURITY.md", "release-files.json", ".env.example", "启动.cmd", "安装每周任务.cmd"]
}
