# Optional. Copy to .env; never commit your .env file.
# Shell environment variables take precedence over .env.
PORT=3210
# Keep this default for Windows scheduled tasks installed by the helper.
RADAR_DATA_DIR=./data
# Leave blank for anonymous access to public repositories.
GITHUB_TOKEN=
# Optional proxy support (Node.js 22.21+); set both only when needed.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
# Windows auto-detects the enabled system HTTP proxy; no local address is bundled.
# Explicit override (HTTP/HTTPS proxy only):
# RADAR_PROXY=http://127.0.0.1:7890
# Set to direct to ignore proxy configuration:
# RADAR_NETWORK_MODE=direct
